package="RemoteDesktopRelay"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="RemoteDesktop Relay"
description="Self-hosted rendezvous relay for RemoteDesktop — control a Windows PC from another over the internet, TeamViewer style, without port forwarding on the client side. The end-to-end encrypted traffic is opaque to this relay. The package page links to the Windows Host and Viewer downloads."
maintainer="RemoteDesktop"
arch="x86_64"
dsmuidir="ui"
dsmappname="com.remotedesktop.relay"
ctl_stop="yes"
startable="yes"
thirdparty="yes"
support_conf_folder="yes"
silent_install="yes"
silent_upgrade="yes"
