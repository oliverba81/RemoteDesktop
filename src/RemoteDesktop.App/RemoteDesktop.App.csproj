<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>..\..\build\app.manifest</ApplicationManifest>
    <AssemblyName>RemoteDesktop</AssemblyName>
    <RootNamespace>RemoteDesktop.App</RootNamespace>
    <!-- Overridden by the release workflow (-p:Version=<tag>); this is the
         local/dev fallback and the baseline the auto-updater compares against. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI for at-rest address-book password encryption (CurrentUser scope). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Shared\RemoteDesktop.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared WinForms helper (kept out of the cross-platform Shared library). -->
    <Compile Include="..\..\build\shared-windows\ClipboardMonitor.cs" Link="Windows\ClipboardMonitor.cs" />
  </ItemGroup>

</Project>
