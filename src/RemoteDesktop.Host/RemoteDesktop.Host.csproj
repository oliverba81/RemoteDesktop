<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>..\..\build\app.manifest</ApplicationManifest>
    <AssemblyName>RemoteDesktopHost</AssemblyName>
    <RootNamespace>RemoteDesktop.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Shared\RemoteDesktop.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared WinForms helper (kept out of the cross-platform Shared library). -->
    <Compile Include="..\..\build\shared-windows\ClipboardMonitor.cs" Link="Windows\ClipboardMonitor.cs" />
  </ItemGroup>

</Project>
