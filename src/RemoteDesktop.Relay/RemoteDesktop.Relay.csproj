<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>remotedesktop-relay</AssemblyName>
    <RootNamespace>RemoteDesktop.Relay</RootNamespace>
    <!-- Synology DSM ships no ICU; invariant mode avoids the libicu dependency
         so a self-contained publish starts on minimal userland. All string
         comparisons in the relay are Ordinal. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Shared\RemoteDesktop.Shared.csproj" />
  </ItemGroup>

</Project>
